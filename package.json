{
  "name": "worktree-helper",
  "displayName": "Worktree Helper",
  "description": "Create git worktrees with environment configuration directly from the VS Code Command Palette.",
  "version": "0.0.1",
  "publisher": "BrunoCCPires",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrunoCCPires/VsCode-Worktree-Helper"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:worktree-helper.createWorktree"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "worktree-helper.createWorktree",
        "title": "Worktree Helper: Create New Worktree",
        "category": "Worktree Helper"
      }
    ],
    "configuration": {
      "title": "Worktree Helper",
      "properties": {
        "worktree-helper.presets": {
          "type": "array",
          "description": "Custom presets with additional directories to copy .env files and post-creation commands.",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the preset displayed in the selection."
              },
              "description": {
                "type": "string",
                "description": "Optional description shown when choosing the preset."
              },
              "envTargets": {
                "type": "array",
                "description": "Relative paths to the worktree that should also receive .env files.",
                "default": [],
                "items": {
                  "type": "string"
                }
              },
              "postCommands": {
                "type": "array",
                "description": "Commands executed after worktree creation. Each command runs in series.",
                "default": [],
                "items": {
                  "type": "object",
                  "required": [
                    "command"
                  ],
                  "properties": {
                    "command": {
                      "type": "string",
                      "description": "Binary or script to be executed."
                    },
                    "args": {
                      "type": "array",
                      "description": "Arguments passed to the command.",
                      "items": {
                        "type": "string"
                      }
                    },
                    "cwd": {
                      "type": "string",
                      "description": "Working directory. Can be relative to the worktree or use the placeholders ${workspaceRoot} and ${worktreePath}."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "prepublishOnly": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.87.0",
    "typescript": "^5.4.5",
    "vsce": "^2.15.0"
  }
}
